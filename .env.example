# Supabase project (Settings → API). The anon key is safe to ship: RLS protects the data.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Firebase project (Project settings → General → Your apps → Web app). Used ONLY for
# sending the borrower's OTP. Leave empty to disable the Verify button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=xxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=xxxx
VITE_FIREBASE_APP_ID=1:123:web:abc

# Name shown in the app header and OTP screen.
VITE_LENDER_NAME="Sanjay Yadav"

# Used only by `npm run db:push` (no VITE_ prefix, so it is never bundled).
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.xxxx.supabase.co:5432/postgres

# Development only: open every screen with a fake session and no backend (ignored in production builds).
# VITE_DEV_BYPASS_AUTH=1
