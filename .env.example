# Supabase project (Settings → API). The anon key is safe to ship: RLS protects the data.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...


# Name shown in the app header and sign-in screen.
VITE_LENDER_NAME="Sanjay Yadav"

# Used only by `npm run db:push` (no VITE_ prefix, so it is never bundled).
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.xxxx.supabase.co:5432/postgres

# Development only: open every screen with a fake session and no backend (ignored in production builds).
# VITE_DEV_BYPASS_AUTH=1
